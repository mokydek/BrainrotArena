# Supabase → Project Settings → API
# (URL and anon key of project vuknddvhpwkyjvrypaql are built in; set these only for another project)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role / secret key (server only!)

# Password for /admin (admins see the "+" buttons and giveaway controls)
ADMIN_PASSWORD=change-me-to-something-long

# Optional: lets the admin "Create tables" button set up the database automatically
# (Supabase → Connect → Session pooler / Direct connection string). Added automatically by the Vercel ↔ Supabase integration.
POSTGRES_URL_NON_POOLING=postgres://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional: link for the "YOUR STREAM HERE" card under the leaderboards (Telegram, Instagram, e-mail…)
CONTACT_URL=
